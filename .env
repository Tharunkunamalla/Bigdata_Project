# ==============================================================================
# CSE412 Big Data Project: Environment Configuration
# ==============================================================================

# Hardware Profile: 'lite' (≤12GB RAM, 1 datanode, 1 worker) or 'full' (16GB+, multi-worker)
PROFILE=lite

# Cluster Networking & Endpoints
DOCKER_HOST_IP=localhost

# Kafka Configuration (KRaft Mode)
KAFKA_BROKER=localhost:9092
KAFKA_INTERNAL_BROKER=kafka:9093
KAFKA_TOPIC_RAW_POSTS=raw_posts
KAFKA_TOPIC_HAZARDS=hazard_events
KAFKA_TOPIC_SCORED_POSTS=scored_posts
KAFKA_TOPIC_ALLOCATIONS=allocations

# HDFS Configuration
HDFS_NAMENODE_URL=hdfs://localhost:9000
HDFS_INTERNAL_NAMENODE_URL=hdfs://namenode:9000
HDFS_WEBHDFS_URL=http://localhost:9870
HDFS_USER=hadoop

# Hive Metastore & HiveServer2
HIVE_SERVER2_HOST=localhost
HIVE_SERVER2_PORT=10000
HIVE_METASTORE_PORT=9083
HIVE_DATABASE=disaster_analytics

# Spark Master & Driver
SPARK_MASTER_URL=spark://localhost:7077
SPARK_INTERNAL_MASTER_URL=spark://spark-master:7077
SPARK_UI_PORT=8085
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# Simulation & Replay Engine
REPLAY_SPEED_MULTIPLIER=5
SYNTHETIC_INJECTION_PROBABILITY=0.25
ACTIVE_SCENARIO=hurricane_harvey

# Application Serving
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional API Credentials (Leave empty for synthetic offline mode)
GEMINI_API_KEY=
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
